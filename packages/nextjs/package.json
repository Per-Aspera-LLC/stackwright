{
    "name": "@stackwright/nextjs",
    "version": "0.6.2",
    "description": "Next.js implementations for Stackwright components",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Per-Aspera-LLC/stackwright"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.mjs",
            "require": "./dist/server.js"
        },
        "./app-router": {
            "types": "./dist/app-router.d.ts",
            "import": "./dist/app-router.mjs",
            "require": "./dist/app-router.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup ",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:run": "vitest run",
        "prepublishOnly": "npm run build",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@stackwright/core": "workspace:*",
        "@stackwright/themes": "workspace:*",
        "@stackwright/types": "workspace:*",
        "js-yaml": "catalog:"
    },
    "devDependencies": {
        "@swc/core": "^1.15.40",
        "@testing-library/jest-dom": "^6.6",
        "@testing-library/react": "^16.3",
        "@types/js-yaml": "catalog:",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "jsdom": "^29.1.1",
        "next": "^16.1.6",
        "react": "^19",
        "react-dom": "^19",
        "tsup": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "next": ">=16.1.7",
        "react": "^19",
        "react-dom": "^19"
    }
}
