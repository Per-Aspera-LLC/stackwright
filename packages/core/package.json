{
    "name": "@stackwright/core",
    "version": "0.10.1",
    "description": "Core framework for building applications from YAML configuration",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Per-Aspera-LLC/stackwright"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./DynamicPage": {
            "types": "./dist/components/DynamicPage.d.ts",
            "import": "./dist/components/DynamicPage.mjs",
            "require": "./dist/components/DynamicPage.js"
        },
        "./pages/slug": {
            "types": "./dist/pages/SlugPage.d.ts",
            "import": "./dist/pages/SlugPage.mjs",
            "require": "./dist/pages/SlugPage.js"
        },
        "./carousel": {
            "types": "./dist/components/narrative/Carousel/Carousel.d.ts",
            "import": "./dist/components/narrative/Carousel/Carousel.mjs",
            "require": "./dist/components/narrative/Carousel/Carousel.js"
        },
        "./map": {
            "types": "./dist/components/base/Map.d.ts",
            "import": "./dist/components/base/Map.mjs",
            "require": "./dist/components/base/Map.js"
        },
        "./code-block": {
            "types": "./dist/components/base/CodeBlock.d.ts",
            "import": "./dist/components/base/CodeBlock.mjs",
            "require": "./dist/components/base/CodeBlock.js"
        },
        "./faq": {
            "types": "./dist/components/base/Faq.d.ts",
            "import": "./dist/components/base/Faq.mjs",
            "require": "./dist/components/base/Faq.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@radix-ui/react-accordion": "^1.2.13",
        "@stackwright/themes": "workspace:*",
        "@stackwright/types": "workspace:*",
        "js-yaml": "catalog:",
        "micromark": "^4.0.1",
        "shiki": "^4.2.0",
        "uuid": "^13.0.0",
        "zod": "catalog:"
    },
    "optionalDependencies": {
        "fuse.js": "^7.4.2"
    },
    "devDependencies": {
        "@stackwright/collections": "workspace:*",
        "@stackwright/types": "workspace:*",
        "@swc/core": "^1.15.40",
        "@testing-library/jest-dom": "^6.6",
        "@testing-library/react": "^16.3",
        "@types/node": "catalog:",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitest/ui": "^4.1.8",
        "jsdom": "^29.1.1",
        "react": "^19",
        "react-dom": "^19",
        "tsup": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "react": "^19",
        "react-dom": "^19"
    }
}
