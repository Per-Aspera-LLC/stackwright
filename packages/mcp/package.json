{
    "name": "@stackwright/mcp",
    "version": "0.5.2",
    "description": "MCP server for Stackwright — exposes content types, page management, and validation as agent tools",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Per-Aspera-LLC/stackwright"
    },
    "bin": {
        "stackwright-mcp": "dist/server.js"
    },
    "main": "./dist/server.js",
    "types": "./dist/server.d.ts",
    "exports": {
        ".": {
            "types": "./dist/server.d.ts",
            "require": "./dist/server.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "pnpm build",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.27.0",
        "@stackwright/build-scripts": "workspace:*",
        "@stackwright/cli": "workspace:*",
        "@stackwright/types": "workspace:*",
        "playwright": "^1.61.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "fs-extra": "^11.3.5",
        "tsup": "catalog:"
    }
}
