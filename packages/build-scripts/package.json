{
    "name": "@stackwright/build-scripts",
    "version": "0.8.0-alpha.7",
    "description": "Build-time scripts for Stackwright projects (prebuild image processing, YAML compilation)",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Per-Aspera-LLC/stackwright"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js"
        }
    },
    "bin": {
        "stackwright-prebuild": "dist/prebuild.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "prepublishOnly": "pnpm run build",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@stackwright/sbom-generator": "workspace:*",
        "@stackwright/types": "workspace:*",
        "js-yaml": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/js-yaml": "catalog:",
        "@types/node": "catalog:",
        "tsup": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
