{
    "name": "@stackwright/types",
    "version": "1.6.0-alpha.3",
    "description": "TypeScript types and JSON schemas for Stackwright",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Per-Aspera-LLC/stackwright"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./validation": {
            "types": "./dist/validation.d.ts",
            "import": "./dist/validation.mjs",
            "require": "./dist/validation.js"
        },
        "./validation-hints": {
            "types": "./dist/validation-hints.d.ts",
            "import": "./dist/validation-hints.mjs",
            "require": "./dist/validation-hints.js"
        },
        "./schemas/theme-schema.json": "./schemas/theme-schema.json",
        "./schemas/content-schema.json": "./schemas/content-schema.json",
        "./schemas/siteconfig-schema.json": "./schemas/site-config-schema.json"
    },
    "files": [
        "dist",
        "schemas"
    ],
    "scripts": {
        "build": "tsup && pnpm generate-schemas",
        "generate-schemas": "tsx src/generate-schemas.ts",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@stackwright/themes": "workspace:*",
        "js-yaml": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.4.0",
        "@types/fs-extra": "11.0.4",
        "@types/js-yaml": "catalog:",
        "@types/react": "^19.2.14",
        "fs-extra": "^11.3.5",
        "tsup": "catalog:",
        "tsx": "^4.22.4",
        "vitest": "catalog:"
    }
}
